local env = (typeof(getgenv) == "function" and getgenv()) or _G
if type(env.__GR_AUTO_UNLOAD) == "function" then pcall(env.__GR_AUTO_UNLOAD) end

local Players = game:GetService("Players")
local Chat = game:GetService("Chat")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end

local ANSWER_DELAY = 2.5

local IGNORED = {
	["too slow."] = true, ["too slow"] = true,
	["correct."] = true, ["correct!"] = true,
	["wrong."] = true, ["wrong!"] = true,
	["incorrect."] = true, ["incorrect!"] = true,
	["goodbye."] = true,
}

local RIDDLES = {
	{ { "solace in this realm", "in this realm" }, { noli = true, nosferatu = true, c00lkidd = true, coolkid = true } },
	{ { "willingly without the star", "without the star" }, { noli = true, c00lkidd = true, coolkid = true } },
	{ { "lost their mind", "bloodshed" }, { guest666 = true, sixer = true, stalker = true, c00lkidd = true, coolkid = true } },
	{ { "exploited in the world", "extensively" }, { c00lkidd = true, coolkid = true, itrapped = true, noli = true } },
	{ { "interacted with the admins", "with the admins" }, { itrapped = true, ["1x1x1x1"] = true, johndoe = true } },
	{ { "play alone in their stories", "alone in their stories" }, { nosferatu = true, stalker = true, noli = true } },
	{ { "blade from the heights", "from the heights" }, { ["1x1x1x1"] = true, c00lkidd = true, coolkid = true, itrapped = true } },
	{ { "contempt towards another", "hold a contempt" }, { guest666 = true, sixer = true, azure = true, ["1x1x1x1"] = true } },
	{ { "ill fated end", "ill-fated end" }, { azure = true, johndoe = true, slasher = true } },
	{ { "follow the morning star", "morning star" }, { itrapped = true, azure = true } },
}

local lastQuestion, lastQuestionAt = "", 0
local unloaded = false
local guiConn, origNamecall

local function norm(s)
	return tostring(s or ""):lower():gsub("[^%w]", "")
end

local function findAnswer(answers, question)
	local q = question:lower():gsub("%s+", " ")
	if q == "" then return nil end

	for _, entry in ipairs(RIDDLES) do
		for _, pat in ipairs(entry[1]) do
			if q:find(pat, 1, true) then
				local valid = entry[2]
				for i = 1, 3 do
					if answers[i] and valid[norm(answers[i])] then
						return i
					end
				end
				return nil
			end
		end
	end
end

local function clickButton(btn)
	if typeof(firesignal) == "function" then
		pcall(firesignal, btn.Activated)
		pcall(firesignal, btn.MouseButton1Click)
		return
	end
	if typeof(getconnections) == "function" then
		for _, sig in ipairs({ btn.Activated, btn.MouseButton1Click }) do
			for _, conn in ipairs(getconnections(sig)) do
				pcall(function() conn:Fire() end)
			end
		end
	end
end

if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
	pcall(function()
		origNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if not unloaded and self == Chat and getnamecallmethod() == "Chat" then
				local part, msg = ...
				if type(msg) == "string" and msg ~= "" and part and part.Name ~= "ChatBubble" then
					local clean = msg:lower():match("^%s*(.-)%s*$")
					if not IGNORED[clean] then
						lastQuestion = msg
						lastQuestionAt = os.clock()
					end
				end
			end
			return origNamecall(self, ...)
		end)
	end)
end

local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
if pg then
	guiConn = pg.ChildAdded:Connect(function(gui)
		if unloaded or gui.Name ~= "DialogUIRetroWow" then return end

		task.delay(ANSWER_DELAY, function()
			if unloaded or not gui.Parent then return end

			local tc = gui:FindFirstChild("Background") and gui.Background:FindFirstChild("TextContainer")
			if not tc then return end

			local btns, answers = {}, {}
			for i = 1, 3 do
				local b = tc:FindFirstChild("Response" .. i)
				if b and b:IsA("TextButton") then
					btns[i], answers[i] = b, b.Text
				end
			end

			local q = (os.clock() - lastQuestionAt <= 12) and lastQuestion or ""
			local idx = findAnswer(answers, q)
			if idx and btns[idx] then
				clickButton(btns[idx])
			end
		end)
	end)
end

env.__GR_AUTO_UNLOAD = function()
	if unloaded then return end
	unloaded = true
	if guiConn then pcall(function() guiConn:Disconnect() end) end
	env.__GR_AUTO_UNLOAD = nil
end
